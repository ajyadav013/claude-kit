# Evaluation harness image — NOT part of the plugin payload, the pip wheel, or any generated
# project. It exists only so the self-evaluation program can run every test, linter, type check,
# scanner, build, and coverage command inside a container instead of on the host.
#
# Stage `python-eval` is the Claude Kit verification environment: the product's runtime deps plus
# its dev toolchain, installed into a world-readable venv so the container can run as any UID.
# The repository itself is never COPYed in — it is bind-mounted at run time, so one built image
# serves both the immutable baseline and the mutating candidate checkout.

FROM python:3.12-slim AS python-eval

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH

# git: `python -m build` and provenance checks expect it present; ca-certificates for PyPI.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv "$VIRTUAL_ENV" \
    && pip install --upgrade pip setuptools wheel

# Runtime deps + the `dev` extra from pyproject.toml, plus coverage tooling the evaluation gate
# needs (line AND branch coverage). Pinned to majors that match the project's declared floors.
RUN pip install \
    "typer>=0.12" \
    "jinja2>=3.1" \
    "pyyaml>=6.0" \
    "jsonschema>=4.0" \
    "pytest>=8.0" \
    "pytest-cov>=5.0" \
    "coverage[toml]>=7.5" \
    "build>=1.2" \
    "twine>=5.0" \
    "ruff>=0.6" \
    "mypy>=1.10" \
    "shellcheck-py>=0.10" \
    && chmod -R a+rX "$VIRTUAL_ENV"

# Writable scratch for arbitrary UIDs (coverage data, build temp dirs, HOME-less pip).
ENV HOME=/tmp XDG_CACHE_HOME=/tmp/.cache
RUN mkdir -p /repo /out /tmp/.cache && chmod 0777 /out /tmp/.cache

WORKDIR /repo
