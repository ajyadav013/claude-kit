{
  "version": 3,
  "note": "Deterministic fire / no-fire scenarios for the stdin-driven hook scripts. Expectations are derived from each script's own documented contract, not guessed. Blockers exit 2 and write BLOCKED to stderr; advisories always exit 0 and emit a hookSpecificOutput JSON object on stdout only when they fire. Several no-fire cases are the NEAR MISSES a script's header explicitly claims to spare -- those are the false-positive controls (measure 7), and they are the cases most likely to be wrong.",
  "scenarios": [
    {
      "id": "guard-push-main/fire-plain",
      "script": "guard-push-main.sh",
      "kind": "fire",
      "stdin": {
        "tool_name": "Bash",
        "tool_input": {
          "command": "git push origin main"
        }
      },
      "expect": {
        "exit": 2,
        "stderr_contains": "BLOCKED"
      }
    },
    {
      "id": "guard-push-main/fire-force-refspec",
      "script": "guard-push-main.sh",
      "kind": "fire",
      "stdin": {
        "tool_name": "Bash",
        "tool_input": {
          "command": "git push origin HEAD:refs/heads/master"
        }
      },
      "expect": {
        "exit": 2,
        "stderr_contains": "BLOCKED"
      }
    },
    {
      "id": "guard-push-main/fire-global-opts-quoted",
      "script": "guard-push-main.sh",
      "kind": "fire",
      "stdin": {
        "tool_name": "Bash",
        "tool_input": {
          "command": "git -c user.name=x push origin \"+main\""
        }
      },
      "expect": {
        "exit": 2,
        "stderr_contains": "BLOCKED"
      }
    },
    {
      "id": "guard-push-main/nofire-substring-branch",
      "script": "guard-push-main.sh",
      "kind": "nofire",
      "stdin": {
        "tool_name": "Bash",
        "tool_input": {
          "command": "git push origin feature/main-ui"
        }
      },
      "expect": {
        "exit": 0,
        "stdout_empty": true
      }
    },
    {
      "id": "guard-push-main/nofire-not-a-push",
      "script": "guard-push-main.sh",
      "kind": "nofire",
      "stdin": {
        "tool_name": "Bash",
        "tool_input": {
          "command": "git log --oneline main"
        }
      },
      "expect": {
        "exit": 0,
        "stdout_empty": true
      }
    },
