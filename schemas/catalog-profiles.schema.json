{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog-profiles",
  "title": "claude-kit SDLC profiles (catalog/profiles.yaml)",
  "type": "object",
  "required": [
    "version",
    "profiles"
  ],
  "properties": {
    "version": {
      "type": "integer"
    },
    "default": {
      "type": "string"
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "inherit": {
            "type": "string"
          },
          "agents": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "const": "all"
              }
            ]
          },
          "skills": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "const": "all"
              }
            ]
          },
          "gates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hooks": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "const": "all"
              }
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
