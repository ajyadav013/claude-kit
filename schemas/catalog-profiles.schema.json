{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog-profiles",
  "title": "claude-kit SDLC profiles (catalog/profiles.yaml)",
  "type": "object",
  "required": [
    "version",
    "profiles"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [1, 2]
    },
    "default": {
      "type": "string"
    },
    "gate_definitions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "requirement",
          "skippable",
          "skip_conditions"
        ],
        "properties": {
          "requirement": {
            "type": "string",
            "enum": [
              "required",
              "conditional"
            ]
          },
          "skippable": {
            "type": "boolean"
          },
          "skip_conditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "requirement": {
                  "const": "required"
                }
              }
            },
            "then": {
              "properties": {
                "skippable": {
                  "const": false
                },
                "skip_conditions": {
                  "maxItems": 0
                }
              }
            },
            "else": {
              "properties": {
                "skippable": {
                  "const": true
                },
                "skip_conditions": {
                  "minItems": 1
                }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "inherit": {
            "type": "string"
          },
          "agents": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "const": "all"
              }
            ]
          },
          "skills": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "const": "all"
              }
            ]
          },
          "gates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hooks": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "const": "all"
              }
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "version": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "gate_definitions"
        ]
      }
    }
  ],
  "additionalProperties": true
}
