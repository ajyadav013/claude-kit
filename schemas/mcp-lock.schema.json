{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mcp-lock",
  "title": "claude-kit resolved MCP lock (.mcp.lock.json)",
  "type": "object",
  "required": [
    "schema",
    "servers"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "servers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "package": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "command": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
