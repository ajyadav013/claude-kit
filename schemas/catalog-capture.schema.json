{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog-capture",
  "title": "claude-kit learning-capture modes (catalog/capture.yaml)",
  "type": "object",
  "required": [
    "version",
    "default",
    "modes"
  ],
  "properties": {
    "version": {
      "type": "integer"
    },
    "default": {
      "type": "string"
    },
    "modes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "hooks"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "hooks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
