{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog-mcp",
  "title": "claude-kit MCP server catalog (catalog/mcp.yaml)",
  "type": "object",
  "required": [
    "version",
    "servers"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "servers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "label",
          "config",
          "runtime_support",
          "authentication",
          "health_check"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "runtime_support": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "claude",
                "codex"
              ]
            }
          },
          "authentication": {
            "type": "object",
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "inferred",
                  "none",
                  "oauth",
                  "host"
                ]
              }
            },
            "additionalProperties": false
          },
          "health_check": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "mcp-initialize"
              }
            },
            "additionalProperties": false
          },
          "config": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "stdio",
                  "http",
                  "sse"
                ]
              },
              "command": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "url": {
                "type": "string"
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "stdio"
                    }
                  }
                },
                "then": {
                  "required": [
                    "command"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "enum": [
                        "http",
                        "sse"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "url"
                  ]
                }
              }
            ],
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
