{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "org-pack",
  "title": "claude-kit org capability pack manifest (pack.yaml)",
  "type": "object",
  "required": [
    "id",
    "label",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "teams": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_default": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "existing"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "existing": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "existing"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "existing": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "existing"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "existing": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "hooks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "existing"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "existing": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
