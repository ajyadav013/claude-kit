{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claude-code-compatibility",
  "title": "claude-kit Claude Code compatibility policy",
  "type": "object",
  "required": [
    "version",
    "minimum",
    "stable_as_of",
    "tested",
    "features",
    "recognized_events"
  ],
  "properties": {
    "version": {"const": 1},
    "minimum": {"$ref": "#/$defs/version"},
    "stable_as_of": {"type": "string", "format": "date"},
    "tested": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["version", "role", "tested_at", "ci"],
        "properties": {
          "version": {"$ref": "#/$defs/version"},
          "role": {"enum": ["minimum", "observed", "current-stable"]},
          "tested_at": {"type": "string", "format": "date"},
          "ci": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["minimum_version", "required"],
        "properties": {
          "minimum_version": {"$ref": "#/$defs/version"},
          "required": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "recognized_events": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
  },
  "additionalProperties": false
}
