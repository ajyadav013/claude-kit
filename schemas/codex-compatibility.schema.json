{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex-compatibility",
  "title": "claude-kit Codex compatibility policy",
  "type": "object",
  "required": [
    "version",
    "host",
    "status",
    "minimum",
    "current_stable",
    "stable_as_of",
    "tested",
    "features",
    "events",
    "agents",
    "skills",
    "plugins",
    "mcp"
  ],
  "properties": {
    "version": {"const": 1},
    "host": {"const": "codex"},
    "status": {"enum": ["preview", "stable", "deprecated"]},
    "minimum": {"$ref": "#/$defs/version"},
    "current_stable": {"$ref": "#/$defs/version"},
    "stable_as_of": {"type": "string", "format": "date"},
    "tested": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["version", "role", "tested_at", "ci", "plugin_validator"],
        "properties": {
          "version": {"$ref": "#/$defs/version"},
          "role": {"enum": ["minimum", "observed", "current-stable"]},
          "tested_at": {"type": "string", "format": "date"},
          "ci": {"type": "boolean"},
          "plugin_validator": {"$ref": "#/$defs/pluginValidator"}
        },
        "additionalProperties": false
      }
    },
    "features": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/capability"}
    },
    "events": {
      "type": "object",
      "required": [
        "support",
        "project_sources",
        "plugin_source",
        "handler_types",
        "trust_required",
        "recognized",
        "required_by_projection",
        "plugin_environment",
        "documentation"
      ],
      "properties": {
        "support": {"$ref": "#/$defs/support"},
        "project_sources": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
        "plugin_source": {"type": "string", "minLength": 1},
        "handler_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["command", "prompt", "agent"]}
        },
        "trust_required": {"type": "boolean"},
        "recognized": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
        "required_by_projection": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
        "plugin_environment": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
        "documentation": {"$ref": "#/$defs/officialDoc"}
      },
      "additionalProperties": false
    },
    "agents": {
      "type": "object",
      "required": [
        "support",
        "project_directory",
        "format",
        "model_tier_mapping",
        "sandbox_mapping",
        "required_fields",
        "inheritable_fields",
        "documentation"
      ],
      "properties": {
        "support": {"$ref": "#/$defs/support"},
        "project_directory": {"const": ".codex/agents"},
        "format": {"const": "toml"},
        "model_tier_mapping": {"$ref": "#/$defs/codexModelTierMapping"},
        "sandbox_mapping": {"$ref": "#/$defs/codexSandboxMapping"},
        "required_fields": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
        "inheritable_fields": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
        "documentation": {"$ref": "#/$defs/officialDoc"}
      },
      "additionalProperties": false
    },
    "skills": {
      "type": "object",
      "required": [
        "support",
        "project_directory",
        "required_file",
        "required_frontmatter",
        "metadata_file",
        "manual_only_field",
        "explicit_invocation_prefix",
        "documentation"
      ],
      "properties": {
        "support": {"$ref": "#/$defs/support"},
        "project_directory": {"const": ".agents/skills"},
        "required_file": {"const": "SKILL.md"},
        "required_frontmatter": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
        "metadata_file": {"const": "agents/openai.yaml"},
        "manual_only_field": {"const": "policy.allow_implicit_invocation"},
        "explicit_invocation_prefix": {"const": "$"},
        "documentation": {"$ref": "#/$defs/officialDoc"}
      },
      "additionalProperties": false
    },
    "plugins": {
      "type": "object",
      "required": [
        "support",
        "package_root",
        "manifest",
        "repo_marketplace",
        "marketplace_source",
        "default_hooks",
        "component_types",
        "documentation"
      ],
      "properties": {
        "support": {"$ref": "#/$defs/support"},
        "package_root": {"const": "providers/codex/claude-kit"},
        "manifest": {"const": ".codex-plugin/plugin.json"},
        "repo_marketplace": {"const": ".agents/plugins/marketplace.json"},
        "marketplace_source": {"const": "./providers/codex/claude-kit"},
        "default_hooks": {"const": "hooks/hooks.json"},
        "component_types": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
        "documentation": {"$ref": "#/$defs/officialDoc"}
      },
      "additionalProperties": false
    },
    "mcp": {
      "type": "object",
      "required": ["support", "project_config", "table_prefix", "documentation"],
      "properties": {
        "support": {"$ref": "#/$defs/support"},
        "project_config": {"const": ".codex/config.toml"},
        "table_prefix": {"const": "mcp_servers"},
        "documentation": {"$ref": "#/$defs/officialDoc"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "support": {"enum": ["native", "adapted", "degraded", "unsupported"]},
    "officialDoc": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://developers\\.openai\\.com/"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pluginValidator": {
      "type": "object",
      "required": [
        "validate_plugin_sha256",
        "identifier_validation_sha256"
      ],
      "properties": {
        "validate_plugin_sha256": {"$ref": "#/$defs/sha256"},
        "identifier_validation_sha256": {
          "anyOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        }
      },
      "additionalProperties": false
    },
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "codexModelTierMapping": {
      "type": "object",
      "required": ["fast", "balanced", "deep"],
      "properties": {
        "fast": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "balanced": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "deep": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}
      },
      "additionalProperties": false
    },
    "codexSandboxMapping": {
      "type": "object",
      "required": ["read_only", "workspace_write", "external_effect"],
      "properties": {
        "read_only": {"enum": ["read-only", "workspace-write", "danger-full-access"]},
        "workspace_write": {"enum": ["read-only", "workspace-write", "danger-full-access"]},
        "external_effect": {"enum": ["read-only", "workspace-write", "danger-full-access"]}
      },
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "required": ["support", "required", "minimum_version", "documentation"],
      "properties": {
        "support": {"$ref": "#/$defs/support"},
        "required": {"type": "boolean"},
        "minimum_version": {"$ref": "#/$defs/version"},
        "documentation": {"$ref": "#/$defs/officialDoc"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
