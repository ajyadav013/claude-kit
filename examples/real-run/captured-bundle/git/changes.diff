+// Delete removes the task with the given id, returning errNotFound if it does
+// not exist.
+func (s *Store) Delete(id int) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.tasks[id]; !ok {
+		return errNotFound
+	}
+	delete(s.tasks, id)
+	return nil
+}
